{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/start/:provider",
      "destination": "/api/auth?action=oauth&provider=:provider"
    },
    {
      "source": "/auth/callback/:provider",
      "destination": "/api/auth?action=callback&provider=:provider"
    },
    {
      "source": "/u/:username",
      "destination": "/u.html?username=:username"
    }
  ]
}
