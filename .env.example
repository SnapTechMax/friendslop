# Copy to .env.local for `vercel dev`, or run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
SIGNUP_ADMIN_KEY=
# Approval emails (optional until set)
RESEND_API_KEY=
MAIL_FROM="friendslop.wtf <hello@friendslop.wtf>"
MAIL_REPLY_TO=

# Accounts. Base URL for email links and OAuth redirect URIs (default https://friendslop.wtf)
SITE_URL=
# OAuth providers switch on when both values exist
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
